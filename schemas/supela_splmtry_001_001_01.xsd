<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:sup="urn:supela:std:k3:omega:xsd:splmtry.001.001.01"
    targetNamespace="urn:supela:std:k3:omega:xsd:splmtry.001.001.01"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    version="2.0.0-2026-EPSILON">

    <xs:annotation>
        <xs:documentation xml:lang="fr">
            ============================================================================
            AVERTISSEMENT JURIDIQUE ET NORMATIF (PROFIL BILATÉRAL &amp; DETACHED SIDECAR)
            ============================================================================
            L'extension SupelaLineage (et SupelaAuditSeal) est définie dans un schéma XSD
            propriétaire (namespace : urn:supela:std:k3:omega:xsd:splmtry.001.001.01).
            En mode CBPR_PLUS_STRICT, cet élément n'est JAMAIS injecté dans le message
            pacs.008/camt.053 réseau (afin de respecter l'interdiction CBPR+ des extensions
            SupplementaryData non enregistrées), mais émis sous forme de Sidecar XML détaché
            lié cryptographiquement au message SWIFT par BoundUETR et BoundWirePackageSha256.
        </xs:documentation>
    </xs:annotation>

    <xs:simpleType name="RootAnchorCode">
        <xs:restriction base="xs:string">
            <xs:enumeration value="SUP-0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Sha256PrefixedHash">
        <xs:restriction base="xs:string">
            <xs:pattern value="sha256:[a-f0-9]{64}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="UUIDv4Type">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IsvSealToken">
        <xs:restriction base="xs:string">
            <xs:minLength value="8"/>
            <xs:maxLength value="160"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ZkpProofToken">
        <xs:restriction base="xs:string">
            <xs:pattern value="zkp-(snark|schnorr-2048):[a-zA-Z0-9:\-_]{16,2048}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CompensationContractId">
        <xs:restriction base="xs:string">
            <xs:pattern value="COMP-ROLLBACK-[A-Za-z0-9\-_]{3,64}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="SupelaLineageType">
        <xs:sequence>
            <xs:element name="RootAnchor" type="sup:RootAnchorCode"/>
            <xs:element name="MerkleParentHash" type="sup:Sha256PrefixedHash"/>
            <xs:element name="IsvSeal" type="sup:IsvSealToken"/>
            <xs:element name="ZkpProof" type="sup:ZkpProofToken"/>
            <xs:element name="CompensationContract" type="sup:CompensationContractId"/>
            <xs:element name="BoundUETR" type="sup:UUIDv4Type" minOccurs="0"/>
            <xs:element name="BoundWirePackageSha256" type="sup:Sha256PrefixedHash" minOccurs="0"/>
            <xs:element name="Ivms101ZeroPiiCommitment" type="sup:Sha256PrefixedHash" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="SupelaLineage" type="sup:SupelaLineageType"/>
    <xs:element name="SupelaAuditSeal" type="sup:SupelaLineageType"/>

</xs:schema>
